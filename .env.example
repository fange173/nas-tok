# Copy to .env for local runs if you prefer env files.
# docker compose reads variables from docker-compose.yml; override there for NAS deploys.

# REQUIRED in production: a long random string (32+ chars)
SECRET_KEY=nastok-dev-secret-change-me

MEDIA_ROOT=/media/videos
DATABASE_URL=sqlite:////app/data/nasTok.db
TZ=Asia/Shanghai

SCAN_CACHE_TTL=300
MEDIA_ACCESS_CACHE_TTL=45
LOG_RETENTION_DAYS=90
LOGIN_MAX_FAILURES=8
LOGIN_LOCK_SECONDS=300
SHARE_VIEW_THROTTLE_SECONDS=60

# Set true only behind a trusted reverse proxy (nginx). Direct LAN: false
TRUST_PROXY_HEADERS=false
# Set true when serving over HTTPS so the session cookie is Secure
COOKIE_SECURE=false

ENABLE_DOCS=false
RESET_ADMIN_PASSWORD=false
